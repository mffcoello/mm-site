---
import Layout from "../layouts/Layout.astro";

const escritos: { title: string; url: string; date: string; note?: string }[] = [
  {
    title: "somos lo que pensamos",
    url: "https://mcoello.substack.com/p/somos-lo-que-pensamos",
    date: "2026-06-27",
  },
];

const recomendaciones: { title: string; url: string; date?: string; source?: string; note?: string }[] = [
  {
    title: "you are what you think",
    url: "https://nedemery.substack.com/p/you-are-what-you-think",
    source: "substack",
  },
];
---

<Layout title="artículos — mi-sitio" description="lo que he escrito y lo que recomiendo leer.">
  <div class="page-header">
    <h1>artículos</h1>
  </div>

  <div class="columns">

    <section class="col">
      <h2 class="col-heading">lo que he escrito</h2>
      {escritos.length === 0 ? (
        <p class="empty">próximamente.</p>
      ) : (
        <div class="article-list">
          {escritos.map(({ title, url, date, note }) => (
            <a href={url} target="_blank" rel="noopener noreferrer" class="article-card card">
              <span class="date">{new Date(date).toLocaleDateString("es-MX", { year: "numeric", month: "long", day: "numeric" })}</span>
              <h3>{title}</h3>
              {note && <p class="note">{note}</p>}
              <span class="read-more">leer →</span>
            </a>
          ))}
        </div>
      )}
    </section>

    <div class="divider" aria-hidden="true" />

    <section class="col">
      <h2 class="col-heading">lo que recomiendo</h2>
      {recomendaciones.length === 0 ? (
        <p class="empty">próximamente.</p>
      ) : (
        <div class="article-list">
          {recomendaciones.map(({ title, url, date, source, note }) => (
            <a href={url} target="_blank" rel="noopener noreferrer" class="article-card card">
              <div class="article-meta">
                {source && <span class="source">{source}</span>}
                {date && <span class="date">{new Date(date).toLocaleDateString("es-MX", { year: "numeric", month: "long", day: "numeric" })}</span>}
              </div>
              <h3>{title}</h3>
              {note && <p class="note">{note}</p>}
              <span class="read-more">leer →</span>
            </a>
          ))}
        </div>
      )}
    </section>

  </div>
</Layout>

<style>
  .columns {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 0 2.5rem;
    align-items: start;
  }

  .divider {
    background: var(--border);
    height: 100%;
    min-height: 200px;
  }

  .col-heading {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .article-list { display: flex; flex-direction: column; gap: 1rem; }

  .article-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    cursor: pointer;
  }

  .article-meta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .source {
    font-size: 0.7rem;
    background: var(--border);
    padding: 0.15em 0.6em;
    border-radius: 999px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .date {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .article-card h3 {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .note {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .read-more {
    font-size: 0.8rem;
    color: var(--accent);
  }

  .empty {
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .columns { grid-template-columns: 1fr; }
    .divider { height: 1px; min-height: unset; width: 100%; margin: 2rem 0; }
  }
</style>
